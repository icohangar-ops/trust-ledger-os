{
  "name": "trust-ledger-os",
  "version": "0.1.0",
  "private": true,
  "description": "Trust Ledger OS — a trust and risk control plane for AI teams",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:substrate && next build",
    "start": "next start",
    "lint": "npm run build:substrate && tsc --noEmit",
    "build:substrate": "tsc -p decision-substrate/tsconfig.json",
    "test": "npm run build:substrate && node --test decision-substrate/dist/*.test.js",
    "demo:assets": "node scripts/generate-demo-assets.mjs"
  },
  "dependencies": {
    "@cubiczan/chp": "^0.1.1",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0"
  }
}
